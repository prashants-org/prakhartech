rules_version = '2';

// Security rules for the Prakhar Technology staff tools: the letter system (/letters), website
// enquiries (/staff/#/enquiries) and the website's editable content (/staff/#/website).
// Paste into Firebase console → Firestore Database → Rules, then Publish.
//
// Who can do what
//   allowedUsers/{email}  managed only in the Firebase console. role: 'admin' | 'staff'
//   staff                 issue letters, read the register, add their own signature,
//                         write letter templates and change their own
//   website visitors      send an enquiry or quote request (create only, never read)
//   staff, enquiries      read every enquiry, change its status and owner, add comments
//   site editors          change the website's client logos and contact details (site/*):
//                         admins, and staff whose allowedUsers record has siteEditor: true
//   everyone              read the website content (site/*), which the public pages show
//   admin                 everything staff can, plus cancel and reinstate letters, edit an issued
//                         letter's text (each earlier text kept in letterVersions), date a letter
//                         another day of its year, move the next reference number forward (never
//                         back), manage designs and the stamp,
//                         change any letter template, and back up / restore
//
// Nothing is ever deleted (letter templates aside: they are text to copy, not records). Designs
// are never edited: they are retired or replaced by a new version. Only admins change an issued
// letter, and an edit keeps the text it replaced as a version that can't be changed or deleted.
//
// Restore from backup: an admin may re-create a record that is MISSING, with any contents,
// as long as it is stamped restoredAt (now) and restoredBy (themselves). A create can never
// replace an existing document, so a restore can't overwrite anything.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function userPath() { return /databases/$(database)/documents/allowedUsers/$(myEmail()); }
    function isMember() { return signedIn() && exists(userPath()); }
    function isAdmin() { return isMember() && get(userPath()).data.role == 'admin'; }
    function isSiteEditor() {
      return isMember() && (get(userPath()).data.role == 'admin' || get(userPath()).data.get('siteEditor', false) == true);
    }
    function isMe(who) { return who is map && who.email == myEmail(); }
    function settingsPath() { return /databases/$(database)/documents/settings/current; }
    function templatePath(id) { return /databases/$(database)/documents/templates/$(id); }
    function assetPath(id) { return /databases/$(database)/documents/assets/$(id); }
    // Calendar year in India (UTC+5:30), so a letter issued at 00:30 IST on 1 January gets the new year.
    function istYear() { return (request.time + duration.value(330, 'm')).year(); }
    // A letter date "YYYY-MM-DD" in the letter's year (its reference number belongs to that year).
    function validLetterDate(k, year) {
      return k is string
        && k.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && int(k.split('-')[0]) == year
        && int(k.split('-')[1]) >= 1 && int(k.split('-')[1]) <= 12
        && int(k.split('-')[2]) >= 1 && int(k.split('-')[2]) <= 31;
    }
    function isTodayInIndia(k) {
      let now = request.time + duration.value(330, 'm');
      return int(k.split('-')[0]) == now.year() && int(k.split('-')[1]) == now.month() && int(k.split('-')[2]) == now.day();
    }
    function restoring(d) { return isAdmin() && d.restoredAt == request.time && isMe(d.restoredBy); }

    match /allowedUsers/{email} {
      allow get: if signedIn() && email == myEmail();
      allow list: if isAdmin();
      allow write: if false;
    }

    match /settings/{id} {
      allow read: if isMember();
      allow create: if restoring(request.resource.data);
      allow create, update: if isAdmin()
        && id == 'current'
        && request.resource.data.keys().hasOnly(['templateId', 'stampId', 'updatedAt', 'updatedBy'])
        && request.resource.data.updatedAt == request.time
        && isMe(request.resource.data.updatedBy)
        && getAfter(templatePath(request.resource.data.templateId)).data.status == 'available'
        && (request.resource.data.get('stampId', null) == null
            || getAfter(assetPath(request.resource.data.stampId)).data.kind == 'stamp');
      allow delete: if false;
    }

    match /templates/{id} {
      allow read: if isMember();
      allow create: if restoring(request.resource.data);
      allow create: if isAdmin()
        && request.resource.data.status == 'available'
        && request.resource.data.kind in ['classic', 'image']
        && request.resource.data.version is int
        && request.resource.data.family is string
        && request.resource.data.note is string
        && request.resource.data.note.size() > 0
        && request.resource.data.createdAt == request.time
        && isMe(request.resource.data.createdBy);
      // A design is never edited. The only change allowed is retiring one that is not in use.
      allow update: if isAdmin()
        && resource.data.status == 'available'
        && request.resource.data.status == 'retired'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'retiredAt', 'retiredBy'])
        && request.resource.data.retiredAt == request.time
        && isMe(request.resource.data.retiredBy)
        && getAfter(settingsPath()).data.templateId != id;
      allow delete: if false;
    }

    // Signature and stamp images. Never changed once saved, so old letters always show what was used.
    match /assets/{id} {
      allow read: if isMember();
      allow create: if restoring(request.resource.data) && request.resource.data.image.size() < 750000;
      allow create: if isMember()
        && request.resource.data.image is string
        && request.resource.data.image.size() < 750000
        && request.resource.data.createdAt == request.time
        && isMe(request.resource.data.createdBy)
        && ((request.resource.data.kind == 'signature' && request.resource.data.ownerEmail == myEmail())
            || (request.resource.data.kind == 'stamp' && isAdmin()));
      allow update, delete: if false;
    }

    // Last reference number used in each year. Moves up by exactly one, together with the new letter.
    match /counters/{year} {
      allow read: if isMember();
      allow create: if restoring(request.resource.data);
      // A restore may raise a counter that is behind the backup (never lower it), so no number is issued twice.
      allow update: if restoring(request.resource.data)
        && request.resource.data.keys().hasOnly(['last', 'restoredAt', 'restoredBy'])
        && request.resource.data.last is int
        && request.resource.data.last > resource.data.last;
      allow create: if isMember()
        && year == string(istYear())
        && request.resource.data.keys().hasOnly(['last'])
        && request.resource.data.last == 1
        && existsAfter(/databases/$(database)/documents/letters/$(year + '-1'));
      allow update: if isMember()
        && (request.resource.data.keys().hasOnly(['last'])
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last']))
        && request.resource.data.last == resource.data.last + 1
        && existsAfter(/databases/$(database)/documents/letters/$(year + '-' + string(request.resource.data.last)));
      // An admin may move this year's numbering forward (never back); the skipped numbers are never used.
      allow create: if isAdmin()
        && year == string(istYear())
        && skipNote(request.resource.data)
        && request.resource.data.last >= 1;
      allow update: if isAdmin()
        && skipNote(request.resource.data)
        && request.resource.data.last > resource.data.last;
      allow delete: if false;
    }

    function skipNote(d) {
      return d.keys().hasOnly(['last', 'skippedAt', 'skippedBy', 'skipReason'])
        && d.last is int && d.last < 100000
        && d.skippedAt == request.time
        && isMe(d.skippedBy)
        && d.skipReason is string && d.skipReason.size() > 0 && d.skipReason.size() <= 300;
    }

    // The text of a letter that an admin may change after issuing it.
    function letterTextKeys() { return ['recipient', 'subject', 'bodyHtml', 'closing', 'signatoryName', 'designation']; }
    function validLetterText(d) {
      return d.recipient is string && d.recipient.size() <= 2000
        && d.subject is string && d.subject.size() <= 500
        && d.bodyHtml is string && d.bodyHtml.size() <= 100000
        && d.closing is string && d.closing.size() <= 200
        && d.signatoryName is string && d.signatoryName.size() <= 200
        && d.designation is string && d.designation.size() <= 500;
    }
    function versionPath(id, v) { return /databases/$(database)/documents/letterVersions/$(id + '-v' + string(v)); }

    function validNewLetter(id, d) {
      let counterPath = /databases/$(database)/documents/counters/$(string(d.year));
      return d.year == istYear()
        && d.seq is int && d.seq >= 1
        && id == string(d.year) + '-' + string(d.seq)
        && d.ref.matches('PT/' + string(d.year) + '/[0-9]{4,}')
        && int(d.ref.split('/')[2]) == d.seq
        && getAfter(counterPath).data.last == d.seq
        && d.status == 'issued'
        && d.issuedAt == request.time
        && isMe(d.issuedBy)
        && d.templateId == get(settingsPath()).data.templateId
        && (d.signature == null || get(assetPath(d.signature.assetId)).data.ownerEmail == myEmail())
        && (d.stamp == null || get(assetPath(d.stamp.assetId)).data.kind == 'stamp')
        // Dated today, or another day of the same year when an admin issues it.
        && (!('letterDate' in d) || (validLetterDate(d.letterDate, d.year) && (isAdmin() || isTodayInIndia(d.letterDate))));
    }

    match /letters/{id} {
      allow read: if isMember();
      allow create: if isMember() && validNewLetter(id, request.resource.data);
      allow create: if restoring(request.resource.data);
      allow update: if isAdmin()
        && resource.data.status == 'issued'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancelledBy', 'cancelReason'])
        && request.resource.data.cancelledAt == request.time
        && isMe(request.resource.data.cancelledBy)
        && request.resource.data.cancelReason is string
        && request.resource.data.cancelReason.size() > 0;
      // An admin may bring a cancelled letter back, keeping a note of the cancellation.
      allow update: if isAdmin()
        && resource.data.status == 'cancelled'
        && request.resource.data.status == 'issued'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancelledBy', 'cancelReason',
                                                                              'lastCancelled', 'reinstatedAt', 'reinstatedBy', 'reinstateReason'])
        && !('cancelledAt' in request.resource.data)
        && !('cancelReason' in request.resource.data)
        && request.resource.data.lastCancelled is map
        && request.resource.data.reinstatedAt == request.time
        && isMe(request.resource.data.reinstatedBy)
        && request.resource.data.reinstateReason is string
        && request.resource.data.reinstateReason.size() > 0
        && request.resource.data.reinstateReason.size() <= 300;
      // An admin may change the text of an issued letter. The text it replaces must be saved, in
      // the same write, as the next letterVersions record, and something must actually change.
      allow update: if isAdmin()
        && resource.data.status == 'issued'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(letterTextKeys().concat(['version', 'editedAt', 'editedBy', 'editReason']))
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(letterTextKeys())
        && validLetterText(request.resource.data)
        && request.resource.data.version == resource.data.get('version', 1) + 1
        && existsAfter(versionPath(id, resource.data.get('version', 1)))
        && request.resource.data.editedAt == request.time
        && isMe(request.resource.data.editedBy)
        && request.resource.data.editReason is string
        && request.resource.data.editReason.size() > 0
        && request.resource.data.editReason.size() <= 300;
      // An admin may change the date printed on an issued letter (same year), giving a reason.
      allow update: if isAdmin()
        && resource.data.status == 'issued'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['letterDate', 'dateText', 'dateChangedAt', 'dateChangedBy', 'dateChangeReason'])
        && validLetterDate(request.resource.data.letterDate, resource.data.year)
        && request.resource.data.dateText is string
        && request.resource.data.dateText.size() <= 40
        && request.resource.data.dateChangedAt == request.time
        && isMe(request.resource.data.dateChangedBy)
        && request.resource.data.dateChangeReason is string
        && request.resource.data.dateChangeReason.size() > 0
        && request.resource.data.dateChangeReason.size() <= 300;
      allow delete: if false;
    }

    // Earlier text of edited letters, one record per replaced version (id: letterId-vN). Written only
    // together with the edit that replaces it, and never changed or deleted.
    match /letterVersions/{vid} {
      allow read: if isMember();
      allow create: if restoring(request.resource.data);
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(letterTextKeys().concat(['letterId', 'ref', 'version', 'writtenAt', 'writtenBy',
                                                                          'writtenReason', 'savedAt', 'savedBy']))
        && request.resource.data.letterId is string
        && request.resource.data.version is int
        && vid == request.resource.data.letterId + '-v' + string(request.resource.data.version)
        && validLetterText(request.resource.data)
        && get(/databases/$(database)/documents/letters/$(request.resource.data.letterId)).data.get('version', 1) == request.resource.data.version
        && getAfter(/databases/$(database)/documents/letters/$(request.resource.data.letterId)).data.version == request.resource.data.version + 1
        && request.resource.data.savedAt == request.time
        && isMe(request.resource.data.savedBy);
      allow update, delete: if false;
    }

    // Ready-made letter text. Anyone can add one; the writer or an admin can change or delete it.
    function validLetterTemplate(d) {
      return d.keys().hasOnly(['name', 'category', 'description', 'recipient', 'subject', 'bodyHtml', 'closing', 'layout',
                               'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && (!('layout' in d) || d.layout == 'blank')
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.category is string && d.category.size() > 0 && d.category.size() <= 40
        && d.description is string && d.description.size() <= 160
        && d.recipient is string && d.recipient.size() <= 2000
        && d.subject is string && d.subject.size() <= 500
        && d.bodyHtml is string && d.bodyHtml.size() <= 100000
        && d.closing is string && d.closing.size() <= 200
        && d.updatedAt == request.time
        && isMe(d.updatedBy);
    }
    match /letterTemplates/{id} {
      allow read: if isMember();
      allow create: if restoring(request.resource.data);
      allow create: if isMember()
        && validLetterTemplate(request.resource.data)
        && request.resource.data.createdAt == request.time
        && isMe(request.resource.data.createdBy);
      allow update: if isMember()
        && (isAdmin() || isMe(resource.data.createdBy))
        && validLetterTemplate(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isMember() && (isAdmin() || isMe(resource.data.createdBy));
    }

    // ── Website enquiries and quote requests ──
    // Anyone may send one from the website (no sign-in), but only in this exact shape and always
    // as "new". Staff can read them, change the status and who is looking after it. Nothing is
    // deleted: junk is marked as spam.
    function textUpTo(d, k, max) { return d[k] is string && d[k].size() <= max; }
    function validEnquiry(d) {
      return d.keys().hasOnly(['kind', 'subject', 'source', 'page', 'name', 'email', 'phone', 'company', 'fields', 'status', 'emailed', 'createdAt'])
        && d.keys().hasAll(['kind', 'subject', 'source', 'page', 'name', 'email', 'phone', 'company', 'fields', 'status', 'emailed', 'createdAt'])
        && d.kind in ['enquiry', 'quote']
        && textUpTo(d, 'subject', 300) && d.subject.size() > 0
        && textUpTo(d, 'source', 60) && textUpTo(d, 'page', 200)
        && textUpTo(d, 'name', 200) && textUpTo(d, 'email', 254) && textUpTo(d, 'phone', 40) && textUpTo(d, 'company', 200)
        && (d.email.size() > 0 || d.phone.size() > 0)
        && d.fields is map && d.fields.size() <= 12
        && d.status == 'new'
        && d.emailed is bool
        && d.createdAt == request.time;
    }
    match /enquiries/{id} {
      allow create: if validEnquiry(request.resource.data);
      allow create: if restoring(request.resource.data);
      allow read: if isMember();
      allow update: if isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'assignedTo', 'updatedAt', 'updatedBy'])
        && request.resource.data.status in ['new', 'in-progress', 'quoted', 'won', 'lost', 'spam']
        && (request.resource.data.get('assignedTo', null) == null
            || (request.resource.data.assignedTo is map
                && request.resource.data.assignedTo.keys().hasOnly(['email', 'name'])
                && request.resource.data.assignedTo.email is string))
        && request.resource.data.updatedAt == request.time
        && isMe(request.resource.data.updatedBy);
      allow delete: if false;
    }

    // Staff comments on an enquiry: notes, replies sent to the customer, and status changes.
    // Kept as a record, so never edited or deleted.
    match /enquiryNotes/{id} {
      allow read: if isMember();
      allow create: if restoring(request.resource.data);
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['enquiryId', 'kind', 'channel', 'text', 'at', 'by'])
        && request.resource.data.enquiryId is string
        && exists(/databases/$(database)/documents/enquiries/$(request.resource.data.enquiryId))
        && request.resource.data.kind in ['note', 'reply', 'status']
        && (request.resource.data.get('channel', null) == null || request.resource.data.channel in ['email', 'whatsapp', 'phone'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 5000
        && request.resource.data.at == request.time
        && isMe(request.resource.data.by);
      allow update, delete: if false;
    }

    // ── Website content: client logos and contact details ──
    // Shown on the public website, so anyone may read them. Only site editors may change them, in
    // this shape. Never deleted: the website falls back to the details built into it if missing.
    function validContact(d) {
      return d.keys().hasOnly(['phone', 'whatsapp', 'email', 'responseTime', 'hours', 'salesName', 'salesPhone', 'salesEmail',
                               'officeTitle', 'address', 'updatedAt', 'updatedBy'])
        && textUpTo(d, 'phone', 40) && d.phone.size() > 0
        && textUpTo(d, 'whatsapp', 40)
        && textUpTo(d, 'email', 120) && d.email.size() > 0
        && textUpTo(d, 'responseTime', 80) && d.responseTime.size() > 0
        && textUpTo(d, 'hours', 120)
        && textUpTo(d, 'salesName', 80) && textUpTo(d, 'salesPhone', 40) && textUpTo(d, 'salesEmail', 120)
        && textUpTo(d, 'officeTitle', 80)
        && textUpTo(d, 'address', 400) && d.address.size() > 0;
    }
    // Each logo is {id, name, logo}; the page checks every one again before showing it.
    function validClients(d) {
      return d.keys().hasOnly(['items', 'updatedAt', 'updatedBy'])
        && d.items is list
        && d.items.size() >= 1
        && d.items.size() <= 60;
    }
    match /site/{id} {
      allow read: if true;
      allow create: if restoring(request.resource.data);
      allow create, update: if isSiteEditor()
        && request.resource.data.updatedAt == request.time
        && isMe(request.resource.data.updatedBy)
        && ((id == 'contact' && validContact(request.resource.data))
            || (id == 'clients' && validClients(request.resource.data)));
      allow delete: if false;
    }

    // Who did what and when: letters, designs, stamp, letter templates, website content, backups and restores.
    match /auditLog/{id} {
      allow read: if isAdmin();
      allow create: if restoring(request.resource.data);
      allow create: if isMember()
        && request.resource.data.at == request.time
        && isMe(request.resource.data.by)
        && request.resource.data.action is string
        && (request.resource.data.area in ['letters', 'design', 'stamp', 'templates']
            || (request.resource.data.area == 'site' && isSiteEditor())
            || (request.resource.data.area == 'backup' && isAdmin()));
      allow update, delete: if false;
    }
  }
}
